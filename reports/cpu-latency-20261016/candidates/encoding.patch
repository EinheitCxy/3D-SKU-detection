+def _encoded_pages(pages, encoder):
+    """Own at most two uncommitted pages; only the caller writes BIN data."""
+    from collections import deque
+    from concurrent.futures import ThreadPoolExecutor
+
+    pending = deque()
+    executor = ThreadPoolExecutor(max_workers=2, thread_name_prefix="atlas-encode")
+    pages = iter(pages)
+    try:
+        while True:
+            if len(pending) == 2:
+                page, future = pending.popleft()
+                page["encoded_png"] = future.result()
+                yield page
+            try:
+                original = next(pages)
+            except StopIteration:
+                break
+            rgba = np.array(original["image_rgba"], copy=True, order="C")
+            page = {key: np.array(original[key], copy=True, order="C")
+                    for key in ("positions", "uv", "indices")}
+            page["surfel_count"] = original["surfel_count"]
+            del original
+            pending.append((page, executor.submit(encoder, rgba)))
+            del rgba
+        while pending:
+            page, future = pending.popleft()
+            page["encoded_png"] = future.result()
+            yield page
+    finally:
+        for _, future in pending:
+            future.cancel()
+        if hasattr(pages, "close"):
+            pages.close()
+        executor.shutdown(wait=True, cancel_futures=True)
+
